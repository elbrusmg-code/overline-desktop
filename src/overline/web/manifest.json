{
  "manifest_version": 3,
  "name": "Overline Extension",
  "version": "0.1.0",
  "description": "Customize Tanki Online with a local interface theme, overtime timer, and companion controls.",
  "icons": {
    "16": "src/assets/branding/icons/icon-16.png",
    "32": "src/assets/branding/icons/icon-32.png",
    "48": "src/assets/branding/icons/icon-48.png",
    "128": "src/assets/branding/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tankionline.com/*",
        "https://*.tankionline.com/*"
      ],
      "js": [
        "src/theme/selector-registry.js",
        "src/theme/index.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "src/assets/branding/icons/icon-32.png",
        "src/theme/styles/tokens.css",
        "src/theme/styles/shell/lobby-header.css",
        "src/theme/styles/shell/inner-header.css",
        "src/theme/styles/shell/lobby.css",
        "src/theme/styles/components/navigation.css",
        "src/theme/styles/components/controls.css",
        "src/theme/styles/components/dialogs.css",
        "src/theme/styles/battle/hud.css",
        "src/theme/styles/battle/chat.css",
        "src/theme/styles/battle/tab.css",
        "src/theme/styles/screens/garage.css",
        "src/theme/styles/screens/containers.css",
        "src/theme/styles/screens/shop.css",
        "src/theme/styles/screens/settings.css",
        "src/theme/styles/screens/missions.css",
        "src/theme/styles/screens/battle-modes.css",
        "src/theme/styles/screens/friends.css",
        "src/theme/styles/screens/ranks-profile.css",
        "src/theme/styles/screens/chat-news.css",
        "assets/sounds/over-20.mp3"
      ],
      "matches": [
        "https://tankionline.com/*",
        "https://*.tankionline.com/*"
      ]
    }
  ]
}
